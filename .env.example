# ==============================================================================
# MCP PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================
# CRITICAL NOTICE:
# MCP integrations, secrets, OAuth sessions, and tool configurations used during
# Google AI Studio development do NOT transfer automatically to Vercel.
#
# You MUST configure required environment variables separately in:
# 1. Google AI Studio Secrets (for AI Studio development & preview)
# 2. Vercel Environment Variables (for Vercel production deployment)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GEMINI AI API KEY (Required)
# ------------------------------------------------------------------------------
# API key for @google/genai TypeScript SDK (Gemini 3.8 Flash & Interactions API).
# - AI Studio: Configured in AI Studio Secrets panel.
# - Vercel: Add to Vercel Project Settings > Environment Variables.
# NEVER expose this key to browser / client bundles (do not prefix with VITE_).
GEMINI_API_KEY="AIzaSy..."

# ------------------------------------------------------------------------------
# 2. APPLICATION HOSTING URL (Required)
# ------------------------------------------------------------------------------
# Deployed URL used for health probes, self-referential endpoints, and callbacks.
# - AI Studio: Injected automatically by Cloud Run environment.
# - Vercel: Set to your production domain (e.g. https://wandersin.vercel.app).
APP_URL="https://your-production-app.vercel.app"

# ------------------------------------------------------------------------------
# 3. REMOTE MCP SERVER URL (Optional Runtime Remote MCP)
# ------------------------------------------------------------------------------
# For runtime MCP connections using Gemini Remote MCP through Interactions API.
# Requirements:
# - Must use a remotely accessible endpoint.
# - Must support Streamable HTTP transport (http:// or https://).
# - Never use local mock protocols (e.g. mcp://internal) in production.
# - If not configured, approved server-side API integrations run natively on Vercel.
# MCP_SERVER_URL="https://mcp.your-domain.com/sse"

# ------------------------------------------------------------------------------
# 4. REMOTE MCP AUTHENTICATION TOKEN (Optional)
# ------------------------------------------------------------------------------
# Bearer token for authenticating with the remote Streamable HTTP MCP server.
# Stored strictly server-side. Never send to React or browser code.
# MCP_AUTH_TOKEN="Bearer your_mcp_auth_token_here"

# ------------------------------------------------------------------------------
# 5. SERVER RUNTIME SETTINGS
# ------------------------------------------------------------------------------
# Port for the Node.js / Express server (default: 3000)
PORT=3000
NODE_ENV="production"
